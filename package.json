{
  "name": "pi-footer-compositor",
  "version": "0.1.0",
  "description": "Compose extension status segments into Pi's built-in footer.",
  "type": "module",
  "license": "MIT",
  "keywords": ["pi-package", "pi", "footer", "status", "tui"],
  "pi": {
    "extensions": ["./pi-footer-compositor.ts"]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@types/node": "24.10.1",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.4",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  }
}
